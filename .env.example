# Application Settings
PROJECT_NAME="Global Intelligence Platform"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_STR=/api/v1

# Database Configuration (PostgreSQL with psycopg3 / asyncpg / sqlite for local tests)
# Production / Local Postgres:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/global_intelligence
# Fallback / Local SQLite testing:
# DATABASE_URL=sqlite:///./global_intelligence.db

# Ingestion & Network Settings
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
BACKOFF_FACTOR=1.5
DEFAULT_USER_AGENT="GlobalIntelligenceBot/0.1 (+https://github.com/global-intelligence/platform)"
