# ========================================================
# Global Intelligence Platform — Environment Configuration Template
# Copy this file to .env and replace placeholder values with secure secrets.
# NEVER commit the active .env file or real credentials into version control.
# ========================================================

# --------------------------------------------------------
# 1. PostgreSQL Database Configuration
# --------------------------------------------------------
POSTGRES_DB=global_intelligence
POSTGRES_USER=postgres
# Use a strong, random password in production (e.g., generated with `openssl rand -base64 24`)
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Internal Database URL used by the FastAPI backend within Docker network:
DATABASE_URL=postgresql+psycopg://postgres:your_secure_postgres_password_here@postgres:5432/global_intelligence

# --------------------------------------------------------
# 2. Application Core Settings
# --------------------------------------------------------
PROJECT_NAME="Global Intelligence Platform"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
API_V1_STR=/api/v1

# Ingestion Scheduler & Worker Pool Orchestration
# When true, the backend container coordinates background ingestion and pipeline workers.
ENABLE_SCHEDULER=true

# Database migration execution during container boot
RUN_MIGRATIONS=true

# Optional: seed verified intelligence sources on first boot (true/false)
SEED_ON_STARTUP=false

# --------------------------------------------------------
# 3. Network & Feed Collector Settings
# --------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=15.0
MAX_RETRIES=3
BACKOFF_FACTOR=1.5
DEFAULT_USER_AGENT="GlobalIntelligencePlatform/1.0 (+https://github.com/MohammedFazilNayaz/global-intelligence-system)"

# --------------------------------------------------------
# 4. Frontend & Web Server Settings
# --------------------------------------------------------
# Default relative URL routed through Nginx reverse proxy (/api/v1)
VITE_API_URL=/api/v1
# Host HTTP port exposed by Nginx
NGINX_PORT=80
